# General Configuration
ENVIRONMENT=development

# Neo4j connection (5.x required). Local default matches docker-compose.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme-local-only
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=your_aura_instance_id
AURA_INSTANCENAME=your_aura_instance_name

# LLM API keys
OPENAI_API_KEY=
GOOGLE_API_KEY=your_google_api_key
GEMINI_API_KEY=your_google_api_key  # Optional: Fallback for GOOGLE_API_KEY
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# Frontend Configuration
VITE_BACKEND_URL=http://localhost:8000

# Authentication
# AUTH_MODE: "header" (development: X-User-Role / X-Tenant-ID headers) or "jwt"
# (required when ENVIRONMENT=production). JWT tokens are HS256 with claims
# sub, role, tenant_id.
AUTH_MODE=
JWT_SECRET=
DEV_DEFAULT_ROLE=ADMIN
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Guards: block (instead of allow) when a safety LLM check cannot run
GUARD_FAIL_CLOSED=false
GUARD_MODEL=gemini-2.5-flash

# MCP server: pin to one tenant when deployed for a single organisation
MCP_TENANT_ID=

# Tracing and Telemetry (tracing is enabled only when this is set)
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# Model Configuration
GEMINI_MODEL_DEFAULT=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
ANTHROPIC_MODEL=claude-sonnet-5

# Redis Cache (Optional for Capstone)
# Redis is not required for the current phase but can be enabled for production performance
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=false
CACHE_DEFAULT_TTL=3600

# Cache TTL by operation (seconds)
CACHE_TTL_DEVIATION=1800
CACHE_TTL_JURISDICTION=3600
CACHE_TTL_PRECEDENT=7200

# Performance Monitoring
MONITORING_ENABLED=true
ALERT_THRESHOLD_CUAD=5000
ALERT_THRESHOLD_DEVIATION=2000
ALERT_THRESHOLD_PRECEDENT=3000
ALERT_THRESHOLD_JURISDICTION=1000

# Parallel Processing
MAX_WORKERS_DEVIATION=3
MAX_WORKERS_PRECEDENT=5
MAX_WORKERS_BATCH=5

# Timeouts (seconds)
TIMEOUT_PATTERN_MATCHING=1.0
TIMEOUT_PRECEDENT_CLAUSE=5.0
TIMEOUT_BATCH_CONTRACT=30.0

# Batch Processing
MAX_BATCH_SIZE=50
BACKGROUND_BATCH_THRESHOLD=10
BATCH_SEMAPHORE_LIMIT=5

# Feature Flags
ENABLE_SEMANTIC_ANALYSIS=true
ENABLE_PARALLEL_PROCESSING=true
ENABLE_ADAPTIVE_LEARNING=true
ENABLE_PHASE_FALLBACK=true
